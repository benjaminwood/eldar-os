#!/usr/bin/env bash
# GitHub-side settings the system relies on, applied with gh (as the repo
# admin). Idempotent: re-run it any time, e.g. after recreating a repo.
#
#   scripts/github-setup [--check]
#
# Staging repo (docs/decisions/0011-eldar-github-app.md):
#   - ruleset on main: only repo admins update it (no deletion, no force-push),
#     so Eldar's GitHub App can open PRs but never merge or push there
#   - rebase-merge off: merges and squashes are signed by GitHub (web-flow)
# Both repos (docs/decisions/0012-cycle-time.md):
#   - push webhook to the machine's apply-hook, signed with the secret in
#     sops (apply-webhook-secret), read from the secrets repo checkout
#
# Not scriptable: creating Eldar's GitHub App and installing it on the
# staging repo (docs/install.md, step 9). --check reports drift, changes nothing.
set -euo pipefail
cd "$(dirname "$0")/.."

# Machine-specific: a fork points these at its own repos and tailnet.
STAGING=benjaminwood/eldar-os-staging
SECRETS=benjaminwood/eldar-os-secrets
# The tailnet's domain (<name>.ts.net) comes from this host's Tailscale, so it
# never needs to be written down here.
TAILNET=${TAILNET:-$(tailscale status --json 2>/dev/null | jq -r '.MagicDNSSuffix // empty')}
[ -n "$TAILNET" ] || { echo "can't tell the tailnet's domain: set TAILNET=<name>.ts.net" >&2; exit 1; }
HOOK_URL=https://eldar-os-hook.$TAILNET/github
SECRETS_CHECKOUT=${SECRETS_CHECKOUT:-../eldar-os-secrets}
SOPS=${SOPS:-$HOME/.local/share/eldar-os-vm/bin/sops}
RULESET_NAME="main: only Ben merges"

check=false
[ "${1:-}" = --check ] && check=true
drift=0
note() { echo "  $*"; }
differs() { echo "  DRIFT: $*"; drift=1; }

echo "== $STAGING: merge methods"
rebase=$(gh api "repos/$STAGING" --jq .allow_rebase_merge)
if [ "$rebase" = false ]; then note "rebase-merge off"
elif $check; then differs "rebase-merge is on"
else gh api -X PATCH "repos/$STAGING" -F allow_rebase_merge=false --silent && note "turned rebase-merge off"; fi

echo "== $STAGING: ruleset on main"
ruleset=$(jq -n --arg name "$RULESET_NAME" '{
  name: $name, target: "branch", enforcement: "active",
  conditions: { ref_name: { include: ["refs/heads/main"], exclude: [] } },
  bypass_actors: [ { actor_id: 5, actor_type: "RepositoryRole", bypass_mode: "always" } ],
  rules: [ { type: "update" }, { type: "deletion" }, { type: "non_fast_forward" } ] }')
id=$(gh api "repos/$STAGING/rulesets" --jq ".[] | select(.name == \"$RULESET_NAME\") | .id")
if [ -n "$id" ]; then
  have=$(gh api "repos/$STAGING/rulesets/$id" --jq '{enforcement, conditions, bypass: [.bypass_actors[] | {actor_id, actor_type, bypass_mode}], rules: [.rules[].type] | sort}')
  want=$(jq '{enforcement, conditions, bypass: .bypass_actors, rules: [.rules[].type] | sort}' <<<"$ruleset")
  if [ "$(jq -S . <<<"$have")" = "$(jq -S . <<<"$want")" ]; then note "ruleset $id as expected"
  elif $check; then differs "ruleset $id differs"
  else gh api -X PUT "repos/$STAGING/rulesets/$id" --input - --silent <<<"$ruleset" && note "updated ruleset $id"; fi
elif $check; then differs "no ruleset named \"$RULESET_NAME\""
else gh api -X POST "repos/$STAGING/rulesets" --input - --jq '"  created ruleset \(.id)"' <<<"$ruleset"; fi

# The secret goes from sops straight into the request body: never printed,
# never in argv.
hook_body() {
  "$SOPS" decrypt --extract '["apply-webhook-secret"]' "$SECRETS_CHECKOUT/eldar-os.yaml" \
    | jq -Rs --arg url "$HOOK_URL" '{active: true, events: ["push"],
        config: {url: $url, content_type: "json", insecure_ssl: "0", secret: .}}'
}
for repo in "$STAGING" "$SECRETS"; do
  echo "== $repo: webhook to apply-hook"
  id=$(gh api "repos/$repo/hooks" --jq ".[] | select(.config.url == \"$HOOK_URL\") | .id")
  if [ -n "$id" ]; then
    state=$(gh api "repos/$repo/hooks/$id" --jq '"\(.active) \(.events | join(",")) \(.config.content_type) \(.config.insecure_ssl) \(.config.secret != null)"')
    if [ "$state" = "true push json 0 true" ]; then
      note "hook $id as expected (the secret itself can't be read back; re-run without --check to reset it)"
      $check || { hook_body | gh api -X PATCH "repos/$repo/hooks/$id" --input - --silent && note "secret re-set"; }
    elif $check; then differs "hook $id: $state"
    else hook_body | gh api -X PATCH "repos/$repo/hooks/$id" --input - --silent && note "updated hook $id"; fi
  elif $check; then differs "no webhook to $HOOK_URL"
  else hook_body | jq '. + {name: "web"}' | gh api -X POST "repos/$repo/hooks" --input - --jq '"  created hook \(.id)"'; fi
done

$check && [ "$drift" = 1 ] && { echo "drift found"; exit 1; }
echo "ok"
