#!/usr/bin/env bash
# Run the Go toolchain for supervisor/ with the Go the Nix package builds with
# (go_1_27 from this flake's pinned nixpkgs), so local builds and tests match.
#
#   scripts/go build ./...
#   scripts/go test ./...
#   CGO_ENABLED=1 scripts/go test -race ./...   (the race detector needs cgo;
#                         builds are static, without it, like the Nix package)
set -euo pipefail
cd "$(dirname "$0")/../supervisor"
export CGO_ENABLED="${CGO_ENABLED:-0}" GOFLAGS=-mod=mod
exec nix shell --quiet --inputs-from .. nixpkgs#go_1_27 -c go "$@"
