#!/usr/bin/env bash
# End-to-end reproduction of the documented install (docs/install.md), against
# the dry-run disk image: fetch the ISO, boot the installer, install from this
# checkout, boot the result, verify it. Never touches the physical disk.
# Runs locally and in CI (.github/workflows/ci.yml).
#
#   scripts/e2e
set -euo pipefail
cd "$(dirname "$0")/.."
VM="scripts/vm --dry-run"
STATE=${ELDAR_OS_VM_STATE:-$HOME/.local/share/eldar-os-vm}/dry-run

step() { echo; echo "=== $* ($(date +%T))"; }
trap 'status=$?; if [ $status -ne 0 ]; then echo "--- serial log tail"; tail -c 4000 "$STATE/serial.log" 2>/dev/null | tr -cd "[:print:]\n"; fi; $VM kill 2>/dev/null || true' EXIT

step "ssh key"
install -d -m 700 ~/.ssh
[ -f ~/.ssh/eldar-os-vm ] || ssh-keygen -q -t ed25519 -N '' -f ~/.ssh/eldar-os-vm

step "installer iso"
scripts/fetch-iso

step "clean dry-run disk"
$VM kill 2>/dev/null || true
$VM reset
[ -e "$STATE/luks-key.img" ] || $VM keygen

step "boot installer"
$VM install
$VM authorize

# The installer has no swap, and nixos-install evaluates eldar-os and Eldar's
# VM in one nix process while it builds: more than a small VM (CI's 5G)
# holds, so it thrashes until the OOM killer ends the install. Compressed
# swap in RAM, as the installed system has (zramSwap), gives it the room.
step "installer swap"
VM_USER=nixos $VM ssh 'set -e; sudo modprobe zram
  dev=$(sudo zramctl -f -a zstd -s "$(awk "/MemTotal/ { print \$2 }" /proc/meminfo)K")
  sudo mkswap -q "$dev" && sudo swapon -p 100 "$dev" && free -m'

step "install"
git ls-files -co --exclude-standard | tar -cf - -T - | VM_USER=nixos $VM ssh 'rm -rf eldar-os && mkdir eldar-os && tar -xf - -C eldar-os'
VM_USER=nixos $VM ssh 'sudo bash eldar-os/scripts/install.sh'

# The config authorizes one specific key (hosts/eldar-os/configuration.nix).
# This run's key may differ (CI, a fork), so let it in through ben's own
# ~/.ssh/authorized_keys on the new disk: test state, not configuration.
step "authorize this run's key on the installed system"
VM_USER=nixos $VM ssh "sudo install -d -m 700 -o 1000 -g 100 /mnt/home/ben/.ssh \
  && echo '$(cat ~/.ssh/eldar-os-vm.pub)' | sudo tee -a /mnt/home/ben/.ssh/authorized_keys >/dev/null \
  && sudo chown 1000:100 /mnt/home/ben/.ssh/authorized_keys && sudo chmod 600 /mnt/home/ben/.ssh/authorized_keys \
  && sync"

# The real machine decrypts secrets (fetched from a private repo) with its own
# SSH host key. Give this throwaway machine a host key up front and a test
# secrets file encrypted to it, so the decryption path is exercised too.
# It must hold every key the config declares (sops.secrets): if one is
# missing, sops-nix installs none of them.
step "seed a host key and test secrets"
VM_USER=nixos $VM ssh 'set -e; cd eldar-os; export NIX_CONFIG="experimental-features = nix-command flakes"
  sudo install -d -m 755 /mnt/etc/ssh /mnt/var/lib/eldar-os/secrets
  sudo ssh-keygen -q -t ed25519 -N "" -C eldar-os-e2e -f /mnt/etc/ssh/ssh_host_ed25519_key
  recipient=$(nix run --inputs-from . nixpkgs#ssh-to-age < /mnt/etc/ssh/ssh_host_ed25519_key.pub)
  printf "%s\n" "canary: secrets-pipeline-ok" "supervisor-env: \"\"" "supervisor-web-env: \"\"" \
    "github-app-key: \"\"" "apply-webhook-secret: \"\"" "remote-hosts:" "  mac: \"\"" > /tmp/test-secrets.yaml
  nix run --inputs-from . nixpkgs#sops -- encrypt --age "$recipient" /tmp/test-secrets.yaml \
    | sudo tee /mnt/var/lib/eldar-os/secrets/eldar-os.yaml >/dev/null
  sync'

step "boot installed system"
$VM stop
$VM start
timeout 300 bash -c "until grep -aq 'eldar-os login:' '$STATE/serial.log'; do sleep 3; done"

step "verify"
for _ in $(seq 30); do $VM ssh true 2>/dev/null && break; sleep 2; done
scripts/verify --dry-run

step "passed"
