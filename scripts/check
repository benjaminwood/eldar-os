#!/usr/bin/env bash
# Evaluate and build this working tree as ben (no root), and show what would
# change against the running system. Catches mistakes before a push; the build
# lands in the store, so the real apply is quick.
#
#   scripts/check            build and diff
#   scripts/check --lock     also update flake.lock for new/changed inputs
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1:-}" = --lock ]; then
  nix flake lock
  git diff --stat flake.lock
fi

# path: so uncommitted and untracked-but-unignored files are seen, as with try.
out=$(nix build --no-link --print-out-paths "path:.#nixosConfigurations.eldar-os.config.system.build.toplevel")
nix store diff-closures /run/current-system "$out"
echo "check ok: $out"
