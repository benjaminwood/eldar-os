#!/usr/bin/env bash
# Apply this working tree to the machine right now, uncommitted: the fast
# inner loop. Run it on eldar-os itself. Uses `nixos-rebuild test`, so the
# boot default stays the last applied staging main, and a reboot (or the next
# scripts/apply) returns to it.
#
#   scripts/try                    build, activate, show what changed
#   DOTFILES=<path> scripts/try    use a local dotfiles checkout (its working
#                                  tree, uncommitted) instead of the pinned one
#
# When it's right: commit, then scripts/apply (already built, so quick).
set -euo pipefail
cd "$(dirname "$0")/.."
# Both paths must match the sudo rules in hosts/eldar-os/configuration.nix.
# The tree is copied there (not built in place) so the rule can name a fixed
# path, and so only tracked and unignored files reach the build.
DIR=/home/ben/.cache/eldar-os-try
DOTDIR=/home/ben/.cache/eldar-os-try-dotfiles

copy() { # <checkout> <dest>
  rm -rf "$2" && mkdir -p "$2"
  git -C "$1" ls-files -co --exclude-standard | tar -C "$1" -cf - -T - | tar -xf - -C "$2"
}

copy . "$DIR"
override=()
if [ -n "${DOTFILES:-}" ]; then
  copy "$DOTFILES" "$DOTDIR"
  override=(--override-input dotfiles "$DOTDIR")
fi

before=$(readlink -f /run/current-system)
sudo /run/current-system/sw/bin/nixos-rebuild test --flake "$DIR#eldar-os" "${override[@]}" 2>&1 \
  | grep -vE '^(building|copying|evaluating)'
nix store diff-closures "$before" /run/current-system
