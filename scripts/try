#!/usr/bin/env bash
# Apply this working tree to the VM right now, uncommitted: the fast inner
# loop. Uses `nixos-rebuild test`, so the boot default stays the last applied
# staging main, and a reboot (or the next scripts/apply) returns to it.
#
#   scripts/try                    build, activate, show what changed
#   DOTFILES=<path> scripts/try    use a local dotfiles checkout (its working
#                                  tree, uncommitted) instead of the pinned one
#   DRY_RUN=1 scripts/try          against the dry-run VM
#
# When it's right: commit, then scripts/apply (already built, so quick).
set -euo pipefail
cd "$(dirname "$0")/.."
VM="scripts/vm${DRY_RUN:+ --dry-run}"
# Both paths must match the sudo rules in hosts/eldar-os/configuration.nix.
DIR=/home/ben/.cache/eldar-os-try
DOTDIR=/home/ben/.cache/eldar-os-try-dotfiles

git ls-files -co --exclude-standard | tar -cf - -T - \
  | $VM ssh "rm -rf $DIR && mkdir -p $DIR && tar -xf - -C $DIR"

override=
if [ -n "${DOTFILES:-}" ]; then
  git -C "$DOTFILES" ls-files -co --exclude-standard | tar -C "$DOTFILES" -cf - -T - \
    | $VM ssh "rm -rf $DOTDIR && mkdir -p $DOTDIR && tar -xf - -C $DOTDIR"
  override="--override-input dotfiles $DOTDIR"
fi

$VM ssh "set -e; before=\$(readlink -f /run/current-system)
  sudo /run/current-system/sw/bin/nixos-rebuild test --flake $DIR#eldar-os $override 2>&1 | grep -vE '^(building|copying|evaluating)'
  nix store diff-closures \"\$before\" /run/current-system"
