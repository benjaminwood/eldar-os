#!/usr/bin/env bash
# Check a booted eldar-os over SSH. Exits non-zero on the first failure.
#
#   scripts/verify            the VM on the real disk
#   scripts/verify --dry-run  the dry-run VM
set -euo pipefail
cd "$(dirname "$0")/.."

scripts/vm "$@" ssh 'bash -s' <<'EOF'
set -euo pipefail
fail() { echo "FAIL: $*" >&2; exit 1; }
ok() { echo "ok: $*"; }

[ "$(hostname)" = eldar-os ] || fail "hostname is $(hostname)"; ok hostname

state=$(systemctl is-system-running --wait || true)
[ "$state" = running ] || { systemctl --failed --no-pager; fail "system is $state"; }; ok "system running"

[ "$(findmnt -no SOURCE /)" = /dev/mapper/cryptroot ] || fail "/ is not on LUKS ($(findmnt -no SOURCE /))"
[ "$(findmnt -no FSTYPE /)" = xfs ] || fail "/ is not XFS"; ok "XFS on LUKS"

f=$(mktemp -p /var/tmp); echo reflink > "$f"
cp --reflink=always "$f" "$f.copy" 2>/dev/null || { rm -f "$f"*; fail "no reflink support"; }; rm -f "$f"*; ok reflinks

[ "$(findmnt -no FSTYPE /boot)" = vfat ] || fail "/boot is not the ESP"
sudo test -f /boot/EFI/BOOT/BOOTX64.EFI || fail "no fallback bootloader"; ok "fallback bootloader"

[ "$(sudo cat /run/secrets/canary 2>/dev/null)" = secrets-pipeline-ok ] || fail "secrets canary not decrypted"; ok "secrets decrypt"

if [ -e /dev/kvm ]; then
  systemctl is-active --quiet microvm@eldar || fail "Eldar's VM isn't running"
  timeout 60 bash -c 'until ping -c1 -W1 10.42.0.2 >/dev/null 2>&1; do sleep 2; done' \
    || { sudo journalctl -b -u microvm@eldar -u microvm-virtiofsd@eldar -u microvm-tap-interfaces@eldar --no-pager -o short-monotonic | tail -40
         fail "Eldar's VM isn't answering"; }
  ok "Eldar's VM up"
else
  ok "Eldar's VM skipped (no KVM here)"
fi

log=$(sudo journalctl -b -o cat)
grep -q 'Found device /dev/disk/by-id/virtio-lukskey' <<<"$log" || fail "initrd never saw the key disk"
grep -q 'Timed out waiting for device /dev/disk/by-id/virtio-lukskey' <<<"$log" \
  && fail "LUKS was unlocked by passphrase, not the key disk"; ok "unlocked by key disk"
EOF
